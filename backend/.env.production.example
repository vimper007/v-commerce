# Production Backend Environment Variables (Railway / Render)
# Copy these into your Railway/Render Environment Variables dashboard.

# Server Port (Railway/Render injects this dynamically, fallback to 5000)
PORT=5000
NODE_ENV=production

# PostgreSQL Database URL (Neon / Supabase / AWS RDS)
# e.g., postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/vcommerce_db?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Redis Connection URL (Upstash / Railway Redis)
# e.g., rediss://default:password@us1-cool-slug-12345.upstash.io:6379
REDIS_URL=redis://default:password@host:6379

# High-entropy JWT Signing Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Stripe Webhook Secret (From Stripe Dashboard -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_production_key
